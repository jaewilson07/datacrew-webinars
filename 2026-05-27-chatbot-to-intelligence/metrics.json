{"metrics":[{"key":"dock_drag","name":"Dock Drag","aliases":["dock drag","drag at the dock","dock slowdown"],"description":"Average pre-start waiting time plus charging wait time.","calculation":"AVG(o.wait_before_start_minutes + o.charge_wait_minutes)","defaultAlias":"dock_drag_minutes","unit":"min","directionality":"higher is worse","dateColumn":"event_date"},{"key":"charge_choke","name":"Charge Choke","aliases":["charge choke","charging choke","charger bottleneck"],"description":"Average minutes a task waits on charging availability.","calculation":"AVG(o.charge_wait_minutes)","defaultAlias":"charge_choke_minutes","unit":"min","directionality":"higher is worse","dateColumn":"event_date"},{"key":"promise_miss","name":"Promise Miss","aliases":["promise miss","missed promise","promise miss rate"],"description":"Share of tasks that breached SLA.","calculation":"SUM(o.sla_breached_flag) / NULLIF(COUNT(*), 0)","defaultAlias":"promise_miss_rate","unit":"rate","directionality":"higher is worse","dateColumn":"event_date"},{"key":"wrench_signal","name":"Wrench Signal","aliases":["wrench signal","maintenance signal","wrench risk"],"description":"Average predictive maintenance risk score.","calculation":"AVG(o.maintenance_risk_score)","defaultAlias":"wrench_signal_score","unit":"score","directionality":"higher is worse","dateColumn":"event_date"},{"key":"bot_burden","name":"Bot Burden","aliases":["bot burden","robot burden","burden time"],"description":"Average idle time plus downtime observed during a shift/task.","calculation":"AVG(o.idle_minutes_during_shift + o.downtime_minutes_during_task)","defaultAlias":"bot_burden_minutes","unit":"min","directionality":"higher is worse","dateColumn":"event_date"},{"key":"stale_signal","name":"Stale Signal","aliases":["stale signal","data staleness","freshness drag"],"description":"Average source latency plus row freshness hours.","calculation":"AVG(o.source_latency_hours + o.row_freshness_hours)","defaultAlias":"stale_signal_hours","unit":"h","directionality":"higher is worse","dateColumn":"ingested_at"}]}
